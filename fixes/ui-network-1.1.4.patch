@@ -0,0 +1,30 @@
+#pragma once
+#include <borealis.hpp>
+#include "view/login_scene.hpp"
+#include <chrono>
+#include <functional>
+#include <optional>
+
+namespace vkpcnx {
+class LoginScreen : public brls::Box {
+public:
+  LoginScreen();
+  // Keep a live focus target in every phase, including loading/error. Otherwise
+  // closing a report dialog can leave Borealis focused on its deleted button.
+  brls::View *getDefaultFocus() override { return refreshTarget; }
+  void setLoading();
+  void setPairing(const std::string &code, const std::string &url);
+  void setError(const std::string &message);
+  void setStatus(const std::string &message, bool canRefresh);
+  void setRefreshHandler(std::function<void()> handler) { refresh = std::move(handler); }
+  void onLayout() override;
+  void draw(NVGcontext *, float, float, float, float, brls::Style, brls::FrameContext *) override;
+  static brls::View *create() { return new LoginScreen(); }
+private:
+  LoginSceneState scene;
+  std::optional<qrcodegen::QrCode> qr;
+  brls::Box *refreshTarget;
+  std::function<void()> refresh;
+  const std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();
+};
+} // namespace vkpcnx
