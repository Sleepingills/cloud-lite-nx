+#include "view/login_screen.hpp"
+#include <algorithm>
+
+namespace vkpcnx {
+LoginScreen::LoginScreen() {
+  setBackgroundColor(nvgRGB(3,10,24));
+  refreshTarget = new brls::Box();
+  refreshTarget->setId("login/refresh");
+  refreshTarget->setPositionType(brls::PositionType::ABSOLUTE);
+  refreshTarget->setFocusable(true);
+  refreshTarget->setHideHighlight(true);
+  refreshTarget->setHideClickAnimation(true);
+  refreshTarget->registerClickAction([this](brls::View *) {
+    if (scene.canRefresh && refresh) refresh();
+    return true;
+  });
+  refreshTarget->addGestureRecognizer(new brls::TapGestureRecognizer(refreshTarget));
+  addView(refreshTarget);
+}
+void LoginScreen::setLoading() {
+  scene = LoginSceneState{};
+  qr.reset();
+}
+void LoginScreen::setPairing(const std::string &code, const std::string &url) {
+  qr = qrcodegen::QrCode::encodeText(url.c_str(),qrcodegen::QrCode::Ecc::MEDIUM);
+  scene.phase = LoginPhase::Waiting; scene.code = code;
+  scene.status = "Ожидание входа"; scene.canRefresh = true; scene.error.clear();
+}
+void LoginScreen::setError(const std::string &message) {
+  scene.phase = LoginPhase::Error; scene.error = message; scene.canRefresh = true;
+  qr.reset();
+}
+void LoginScreen::setStatus(const std::string &message, bool canRefresh) {
+  scene.status = message; scene.canRefresh = canRefresh;
+}
+void LoginScreen::onLayout() {
+  const float scale = std::min(getWidth()/LOGIN_WIDTH,getHeight()/LOGIN_HEIGHT);
+  refreshTarget->setPositionLeft((getWidth()-LOGIN_WIDTH*scale)/2+REFRESH_X*scale);
+  refreshTarget->setPositionTop((getHeight()-LOGIN_HEIGHT*scale)/2+REFRESH_Y*scale);
+  refreshTarget->setDimensions(REFRESH_W*scale,REFRESH_H*scale);
+}
+void LoginScreen::draw(NVGcontext *v,float x,float y,float width,float height,
+                       brls::Style style,brls::FrameContext *ctx) {
+  const float scale = std::min(width/LOGIN_WIDTH,height/LOGIN_HEIGHT);
+  if (scale <= 0) return;
+  nvgSave(v); nvgTranslate(v,x+(width-LOGIN_WIDTH*scale)/2,y+(height-LOGIN_HEIGHT*scale)/2);
+  nvgScale(v,scale,scale);
+  const double seconds=std::chrono::duration<double>(std::chrono::steady_clock::now()-started).count();
+  drawLoginScene(v,seconds,brls::Application::getDefaultFont(),scene,qr?&*qr:nullptr);
+  nvgRestore(v);
+  brls::Box::draw(v,x,y,width,height,style,ctx);
+}
+} // namespace vkpcnx
