@@ -0,0 +1,187 @@
+// Cloud Lite NX: original vector UI based on the user's login-screen reference.
+#include "view/login_scene.hpp"
+#include <algorithm>
+#include <cmath>
+
+namespace vkpcnx {
+namespace {
+constexpr float PI = 3.14159265358979323846f;
+NVGcolor white() { return nvgRGB(245, 248, 255); }
+NVGcolor muted() { return nvgRGB(178, 197, 229); }
+void rounded(NVGcontext *v, float x, float y, float w, float h, float r, NVGcolor c) {
+  nvgBeginPath(v); nvgRoundedRect(v, x, y, w, h, r); nvgFillColor(v, c); nvgFill(v);
+}
+void outline(NVGcontext *v, float x, float y, float w, float h, float r, NVGcolor c, float line=1) {
+  nvgBeginPath(v); nvgRoundedRect(v, x, y, w, h, r); nvgStrokeColor(v, c);
+  nvgStrokeWidth(v, line); nvgStroke(v);
+}
+void text(NVGcontext *v, float x, float y, float size, const std::string &s,
+          NVGcolor c, int align=NVG_ALIGN_LEFT, bool bold=false) {
+  nvgFontSize(v, size); nvgTextAlign(v, align | NVG_ALIGN_MIDDLE);
+  nvgFillColor(v, c); nvgText(v, x, y, s.c_str(), nullptr);
+  if (bold) nvgText(v, x+0.65f, y, s.c_str(), nullptr);
+}
+void circle(NVGcontext *v, float x, float y, float r, NVGcolor c) {
+  nvgBeginPath(v); nvgCircle(v, x, y, r); nvgFillColor(v, c); nvgFill(v);
+}
+void vkMark(NVGcontext *v, float x, float y, float size) {
+  rounded(v, x, y, size, size, size*.27f, nvgRGB(0, 115, 255));
+  nvgSave(v); nvgTranslate(v, x+size*.17f, y+size*.24f); nvgScale(v, size/60, size/60);
+  // A compact V/K monogram with rounded transitions, drawn as paths.
+  nvgBeginPath(v); nvgMoveTo(v, 0, 0); nvgLineTo(v, 7, 0);
+  nvgBezierTo(v, 8, 12, 12, 20, 18, 22); nvgLineTo(v, 18, 0);
+  nvgLineTo(v, 25, 0); nvgLineTo(v, 25, 13);
+  nvgBezierTo(v, 32, 12, 36, 6, 38, 0); nvgLineTo(v, 46, 0);
+  nvgBezierTo(v, 44, 9, 39, 15, 33, 18);
+  nvgBezierTo(v, 40, 21, 45, 27, 47, 34); nvgLineTo(v, 39, 34);
+  nvgBezierTo(v, 37, 28, 32, 23, 25, 22); nvgLineTo(v, 25, 34);
+  nvgLineTo(v, 22, 34); nvgBezierTo(v, 8, 34, 1, 22, 0, 0);
+  nvgClosePath(v); nvgFillColor(v, nvgRGB(255, 255, 255)); nvgFill(v); nvgRestore(v);
+}
+void consoleIcon(NVGcontext *v, float x, float y) {
+  outline(v,x,y,58,29,8,white(),1.6f); outline(v,x+10,y+4,38,21,2,white(),1.3f);
+  circle(v,x+5,y+10,1.5f,white()); circle(v,x+5,y+19,1.5f,white());
+  circle(v,x+53,y+10,1.2f,white()); circle(v,x+53,y+19,1.2f,white());
+}
+void ribbon(NVGcontext *v, float y, float thickness, float phase, NVGcolor a, NVGcolor b) {
+  const float wave = std::sin(phase)*44, sway = std::cos(phase*.83f)*70;
+  nvgBeginPath(v); nvgMoveTo(v,-110,y-150+wave);
+  nvgBezierTo(v,230,y-80+wave,160,y+270+sway,660,y+95);
+  nvgBezierTo(v,1010,y-55-sway,1100,y+65,1390,y+210-wave);
+  nvgLineTo(v,1390,y+210-wave+thickness);
+  nvgBezierTo(v,1080,y+70+thickness,1030,y-20-sway,660,y+135+thickness);
+  nvgBezierTo(v,150,y+310+sway,140,y-15+wave,-110,y-110+wave+thickness);
+  nvgClosePath(v); nvgFillPaint(v,nvgLinearGradient(v,0,y,1280,y+200,a,b)); nvgFill(v);
+}
+void background(NVGcontext *v, float t) {
+  rounded(v,0,0,1280,720,0,nvgRGB(3,10,24));
+  nvgBeginPath(v); nvgRect(v,0,0,1280,720);
+  nvgFillPaint(v,nvgRadialGradient(v,1120+40*std::sin(t*.1f),60,40,720,
+    nvgRGBA(0,79,191,120),nvgRGBA(0,21,57,0))); nvgFill(v);
+  ribbon(v,190,65,t*.16f,nvgRGBA(0,64,255,225),nvgRGBA(0,155,255,210));
+  ribbon(v,415,35,t*.13f+1.5f,nvgRGBA(0,140,255,190),nvgRGBA(0,65,235,130));
+  ribbon(v,10,28,t*.11f+3,nvgRGBA(0,75,255,110),nvgRGBA(0,110,255,210));
+  // Six translucent shapes remain behind the opaque content card.
+  const float xs[]={28,105,12,1213,1192,1300};
+  const float ys[]={115,320,550,185,410,600};
+  for(int i=0;i<6;i++) {
+    float p=t*.17f+i*1.7f;
+    nvgSave(v); nvgTranslate(v,xs[i]+std::sin(p)*15,ys[i]+std::cos(p*.8f)*23);
+    nvgRotate(v,-.32f+std::sin(p*.7f)*.12f);
+    float side=86+(i%3)*14;
+    nvgBeginPath(v); nvgRoundedRect(v,-side/2,-side/2,side,side,14);
+    nvgFillPaint(v,nvgLinearGradient(v,-side/2,-side/2,side/2,side/2,
+      nvgRGBA(0,145,255,125),nvgRGBA(0,52,173,35))); nvgFill(v);
+    outline(v,-side/2,-side/2,side,side,14,nvgRGBA(30,157,255,140),1.3f);
+    nvgRestore(v);
+  }
+}
+void qrCorners(NVGcontext *v) {
+  const float x=733,y=175,w=336,h=336,r=17,l=30;
+  nvgStrokeColor(v,nvgRGB(0,164,255)); nvgStrokeWidth(v,3.5f); nvgLineCap(v,NVG_ROUND);
+  for(int i=0;i<4;i++) {
+    nvgSave(v); nvgTranslate(v,x+(i%2?w:0),y+(i/2?h:0));
+    nvgScale(v,i%2?-1.f:1.f,i/2?-1.f:1.f);
+    nvgBeginPath(v); nvgMoveTo(v,0,l); nvgLineTo(v,0,r);
+    nvgQuadTo(v,0,0,r,0); nvgLineTo(v,l,0); nvgStroke(v); nvgRestore(v);
+  }
+}
+void drawQr(NVGcontext *v, const qrcodegen::QrCode &qr) {
+  // Keep the four-module white quiet zone; no overlay, logo, or animation on QR.
+  const int count=qr.getSize(), quiet=4;
+  const float module=std::floor(302.f/(count+quiet*2));
+  const float total=(count+quiet*2)*module;
+  const float x=901-total/2+quiet*module, y=343-total/2+quiet*module;
+  nvgSave(v); nvgShapeAntiAlias(v,0); nvgBeginPath(v);
+  for(int row=0;row<count;row++) for(int col=0;col<count;col++)
+    if(qr.getModule(col,row)) nvgRect(v,x+col*module,y+row*module,module,module);
+  nvgFillColor(v,nvgRGB(0,0,0)); nvgFill(v); nvgRestore(v);
+}
+void keyHint(NVGcontext *v,float x,float y,const std::string &key,const std::string &label) {
+  nvgBeginPath(v); nvgCircle(v,x,y,16); nvgStrokeColor(v,white()); nvgStrokeWidth(v,1.6f); nvgStroke(v);
+  text(v,x,y,18,key,white(),NVG_ALIGN_CENTER);
+  text(v,x+32,y,18,label,white());
+}
+} // namespace
+
+void drawLoginScene(NVGcontext *v,double seconds,int font,
+                    const LoginSceneState &s,const qrcodegen::QrCode *qr) {
+  nvgSave(v); nvgFontFaceId(v,font); const float t=static_cast<float>(std::fmod(seconds,3600.0));
+  background(v,t);
+  vkMark(v,46,21,60); text(v,123,52,35,"VK Play",white(),NVG_ALIGN_LEFT,true);
+  consoleIcon(v,1070,35); text(v,1144,50,19,"Switch Lite",white());
+
+  nvgBeginPath(v); nvgRoundedRect(v,125,89,1030,546,29);
+  nvgFillPaint(v,nvgBoxGradient(v,140,100,1000,524,22,36,nvgRGBA(0,110,255,65),nvgRGBA(0,42,130,0))); nvgFill(v);
+  nvgBeginPath(v); nvgRoundedRect(v,140,100,1000,524,20);
+  nvgFillPaint(v,nvgLinearGradient(v,140,100,1140,624,nvgRGB(6,18,38),nvgRGB(9,31,63))); nvgFill(v);
+  outline(v,140,100,1000,524,20,nvgRGB(0,132,255),1.5f);
+  outline(v,142,102,996,520,18,nvgRGBA(40,150,255,28),1);
+  nvgBeginPath(v); nvgMoveTo(v,676,148); nvgLineTo(v,676,592);
+  nvgStrokeWidth(v,1); nvgStrokeColor(v,nvgRGBA(0,121,240,120)); nvgStroke(v);
+
+  rounded(v,196,151,210,36,18,nvgRGB(0,112,255));
+  text(v,301,169,15,"ВХОД В АККАУНТ",white(),NVG_ALIGN_CENTER,true);
+  nvgTextLetterSpacing(v,-.6f);
+  text(v,196,235,43,"Вход в VK Play",white(),NVG_ALIGN_LEFT,true);
+  nvgTextLetterSpacing(v,0);
+  text(v,196,285,19,"Отсканируйте QR-код камерой телефона",muted());
+  const char *steps[]={"Откройте камеру телефона","Наведите её на QR-код","Подтвердите вход"};
+  for(int i=0;i<3;i++) {
+    float cy=350+i*64;
+    circle(v,223,cy,24,nvgRGB(4,15,33));
+    nvgBeginPath(v); nvgCircle(v,223,cy,24); nvgStrokeWidth(v,3.3f);
+    nvgStrokeColor(v,nvgRGB(0,126,255)); nvgStroke(v);
+    text(v,223,cy,24,std::to_string(i+1),white(),NVG_ALIGN_CENTER,true);
+    text(v,272,cy,22,steps[i],white());
+  }
+
+  if(s.canRefresh) {
+    nvgBeginPath(v); nvgRoundedRect(v,190,526,458,72,18);
+    nvgFillPaint(v,nvgBoxGradient(v,196,532,446,60,14,20,nvgRGBA(0,110,255,100),nvgRGBA(0,88,255,0))); nvgFill(v);
+  }
+  rounded(v,REFRESH_X,REFRESH_Y,REFRESH_W,REFRESH_H,13,
+          s.canRefresh?nvgRGB(0,108,250):nvgRGB(18,51,94));
+  outline(v,REFRESH_X,REFRESH_Y,REFRESH_W,REFRESH_H,13,
+          s.canRefresh?white():nvgRGB(57,91,133),s.canRefresh?2.3f:1);
+  circle(v,266,562,15,s.canRefresh?white():muted());
+  text(v,266,562,21,"X",nvgRGB(0,105,245),NVG_ALIGN_CENTER);
+  const char *button=s.phase==LoginPhase::Error?"Повторить вход":
+    (s.canRefresh?"Обновить QR-код":"Подключаемся…");
+  text(v,301,562,22,button,white(),NVG_ALIGN_LEFT,true);
+
+  rounded(v,714,156,374,374,20,nvgRGB(7,31,65));
+  outline(v,714,156,374,374,20,nvgRGB(0,101,225),1.3f);
+  qrCorners(v);
+  if(s.phase==LoginPhase::Waiting && qr) {
+    rounded(v,746,188,310,310,15,nvgRGB(255,255,255)); drawQr(v,*qr);
+  } else if(s.phase==LoginPhase::Loading) {
+    circle(v,901,330,48,nvgRGB(8,42,83));
+    nvgBeginPath(v); nvgArc(v,901,330,32,t*1.5f,t*1.5f+PI*1.45f,NVG_CW);
+    nvgStrokeColor(v,nvgRGB(0,152,255)); nvgStrokeWidth(v,4); nvgStroke(v);
+    text(v,901,412,20,"Получаем код входа",muted(),NVG_ALIGN_CENTER);
+  } else {
+    circle(v,901,254,28,nvgRGB(64,33,49)); text(v,901,254,34,"!",nvgRGB(255,155,155),NVG_ALIGN_CENTER,true);
+    text(v,901,309,24,"Не удалось войти",white(),NVG_ALIGN_CENTER,true);
+    nvgFontSize(v,18); nvgTextAlign(v,NVG_ALIGN_CENTER | NVG_ALIGN_TOP); nvgFillColor(v,muted());
+    nvgTextBox(v,760,343,282,s.error.c_str(),nullptr);
+  }
+  const float pulse=.65f+.35f*std::sin(t*2);
+  const NVGcolor dot=s.phase==LoginPhase::Error?nvgRGB(255,133,143):nvgRGBA(0,142,255,static_cast<unsigned char>(180+75*pulse));
+  circle(v,768,561,6,dot);
+  nvgFontSize(v,18);
+  // Transient status stays in one line; long error details live inside the card.
+  const std::string status=s.phase==LoginPhase::Error?"Нажмите X для повтора":s.status;
+  nvgSave(v); nvgIntersectScissor(v,784,545,290,33);
+  text(v,786,561,18,status,muted()); nvgRestore(v);
+  if(s.phase==LoginPhase::Waiting)
+    text(v,901,597,14,"cloud.vkplay.ru/tv  ·  "+s.code,muted(),NVG_ALIGN_CENTER);
+
+  rounded(v,0,650,1280,70,0,nvgRGBA(3,12,27,224));
+  nvgBeginPath(v); nvgMoveTo(v,0,650); nvgLineTo(v,1280,650);
+  nvgStrokeColor(v,nvgRGBA(109,158,219,64)); nvgStrokeWidth(v,1); nvgStroke(v);
+  keyHint(v,64,684,"B","Выйти"); keyHint(v,925,684,"Y","Отчёт");
+  text(v,1232,684,13,"Cloud Lite NX  1.1.4",muted(),NVG_ALIGN_RIGHT);
+  nvgRestore(v);
+}
