diff --git a/tests/focus_host/borealis.hpp b/tests/focus_host/borealis.hpp
new file mode 100644
index 0000000..9fc355f
--- /dev/null
+++ b/tests/focus_host/borealis.hpp
@@ -0,0 +1,17 @@
+#pragma once
+// Headless UI surface for the MainScreen focus contract. Rendering is covered
+// by the Switch build/device check, not by this fixture.
+namespace brls {
+class View {
+public:
+  virtual ~View() = default;
+  virtual View *getDefaultFocus() { return this; }
+};
+class AppletFrame : public View {
+public:
+  View *child = nullptr;
+  View *getDefaultFocus() override { return child; }
+  void setHideHighlight(bool) {}
+  void setHideClickAnimation(bool) {}
+};
+}
diff --git a/tests/startup_focus_test.cpp b/tests/startup_focus_test.cpp
new file mode 100644
index 0000000..ad439c4
--- /dev/null
+++ b/tests/startup_focus_test.cpp
@@ -0,0 +1,67 @@
+#include "view/main_screen.hpp"
+#include <cassert>
+#include <iostream>
+#include <memory>
+#include <vector>
+
+// Model the pinned Borealis push/pop focus contract: push saves only non-null
+// focus; pop only restores a saved entry; giveFocus ignores null targets.
+// The regression occurs when the first report opens above an empty catalogue.
+struct FocusStack {
+  brls::View *current = nullptr;
+  std::vector<brls::View *> saved;
+  void focus(brls::View *view) {
+    auto *next = view ? view->getDefaultFocus() : nullptr;
+    if (next) current = next;
+  }
+  void open(brls::View *modal) {
+    if (current) saved.push_back(current);
+    focus(modal);
+  }
+  void close() {
+    if (!saved.empty()) {
+      focus(saved.back());
+      saved.pop_back();
+    }
+  }
+};
+
+template<class Screen> bool survivesReport(bool catalogueBeforeClose) {
+  Screen screen;
+  brls::View game;
+  FocusStack ui;
+  ui.focus(&screen);
+  auto modal = std::make_unique<brls::View>();
+  ui.open(modal.get());
+  if (catalogueBeforeClose) screen.child = &game;
+  ui.close();
+  const bool safe = ui.current != modal.get();
+  modal.reset();
+  if (!safe) return false; // Do not dereference the old dangling button.
+  assert(ui.current == (catalogueBeforeClose ? &game : &screen));
+  if (!catalogueBeforeClose) {
+    screen.child = &game;
+    ui.focus(&screen);
+    assert(ui.current == &game);
+  }
+  // Nested reports must also restore a live target.
+  brls::View report, result;
+  ui.open(&report);
+  ui.open(&result);
+  ui.close();
+  assert(ui.current == &report);
+  ui.close();
+  assert(ui.current == &game);
+  // Empty/error state keeps a live fallback and does not allocate a dummy view.
+  screen.child = nullptr;
+  assert(screen.getDefaultFocus() == &screen);
+  return true;
+}
+
+int main() {
+  for (bool early : {false, true}) {
+    assert(!survivesReport<brls::AppletFrame>(early)); // Reproduce 1.1.7.
+    assert(survivesReport<vkpcnx::MainScreen>(early));
+  }
+  std::cout << "Startup report focus regression passed (both load/close orders)\n";
+}
diff --git a/vkpcnx/include/view/main_screen.hpp b/vkpcnx/include/view/main_screen.hpp
new file mode 100644
index 0000000..95a7a54
--- /dev/null
+++ b/vkpcnx/include/view/main_screen.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <borealis.hpp>
+
+namespace vkpcnx {
+
+// During asynchronous startup the catalogue and account controls are absent.
+// Borealis only saves a non-null focus when opening a dialog. Without a live
+// fallback, closing the startup report leaves currentFocus on a deleted button.
+class MainScreen : public brls::AppletFrame {
+public:
+  MainScreen() { setHideHighlight(true); setHideClickAnimation(true); }
+
+  brls::View *getDefaultFocus() override {
+    auto *child = brls::AppletFrame::getDefaultFocus();
+    return child ? child : this;
+  }
+
+  static brls::View *create() { return new MainScreen(); }
+};
+
+} // namespace vkpcnx
