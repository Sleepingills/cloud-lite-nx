diff --git a/vkpcnx/include/core/auth/reply.hpp b/vkpcnx/include/core/auth/reply.hpp
index cadbb40..d0e4b29 100644
--- a/vkpcnx/include/core/auth/reply.hpp
+++ b/vkpcnx/include/core/auth/reply.hpp
@@ -58,4 +58,23 @@ inline Reply parse(Stage stage, long status, int transport, const std::string &b
   }
   return {State::Failed, {}, "Ответ сервера не соответствует ожидаемому формату входа."};
 }
+// Only polling is safe to repeat here. Never automatically repeat the OAuth
+// code exchange: the server may already have consumed that one-use code.
+class PollReplies {
+  unsigned consecutiveTimeouts = 0;
+public:
+  Reply next(long status, int transport, const std::string &body) {
+    auto reply = parse(Stage::Poll, status, transport, body);
+    if (transport == 28) {
+      if (consecutiveTimeouts < 2) {
+        ++consecutiveTimeouts;
+        return {State::Pending, {}, "Связь прервалась. Повторяем проверку входа (" +
+          std::to_string(consecutiveTimeouts) + "/2)…"};
+      }
+    } else {
+      consecutiveTimeouts = 0;
+    }
+    return reply;
+  }
+};
 } // namespace vkpcnx::auth
