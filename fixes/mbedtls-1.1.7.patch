diff --git a/scripts/test-mbedtls-http.sh b/scripts/test-mbedtls-http.sh
new file mode 100644
index 0000000..8a7cb1a
--- /dev/null
+++ b/scripts/test-mbedtls-http.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# Build the release's HTTPS backend on Linux and exercise real TLS validation.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+TEST_ROOT="$PWD/build-http-tls"
+TEST_PREFIX="$TEST_ROOT/prefix"
+mkdir -p "$TEST_ROOT" "$TEST_PREFIX"
+curl --fail --location --retry 2 --max-time 120 \
+  https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.4/mbedtls-3.6.4.tar.bz2 \
+  -o "$TEST_ROOT/mbedtls.tar.bz2"
+tar -xf "$TEST_ROOT/mbedtls.tar.bz2" -C "$TEST_ROOT"
+cmake -S "$TEST_ROOT/mbedtls-3.6.4" -B "$TEST_ROOT/mbed-build" \
+  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$TEST_PREFIX" \
+  -DENABLE_TESTING=OFF -DENABLE_PROGRAMS=OFF -DGEN_FILES=OFF \
+  -DUSE_SHARED_MBEDTLS_LIBRARY=OFF -DUSE_STATIC_MBEDTLS_LIBRARY=ON
+cmake --build "$TEST_ROOT/mbed-build" --parallel 2 --target install
+
+curl --fail --location --retry 2 --max-time 120 \
+  https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz \
+  -o "$TEST_ROOT/curl.tar.xz"
+python3 - "$TEST_ROOT/curl.tar.xz" <<'PY'
+from pathlib import Path
+import hashlib, sys
+assert hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest() == \
+    '8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5'
+PY
+tar -xf "$TEST_ROOT/curl.tar.xz" -C "$TEST_ROOT"
+cmake -S "$TEST_ROOT/curl-8.23.0" -B "$TEST_ROOT/curl-build" \
+  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$TEST_PREFIX" \
+  -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON -DBUILD_STATIC_CURL=ON \
+  -DBUILD_TESTING=OFF -DBUILD_LIBCURL_DOCS=OFF -DBUILD_MISC_DOCS=OFF \
+  -DENABLE_CURL_MANUAL=OFF -DCURL_USE_OPENSSL=OFF -DCURL_USE_MBEDTLS=ON \
+  -DCURL_USE_LIBPSL=OFF -DCURL_USE_LIBSSH2=OFF -DUSE_LIBIDN2=OFF \
+  -DUSE_NGHTTP2=OFF -DCURL_BROTLI=OFF -DCURL_ZSTD=OFF \
+  -DENABLE_THREADED_RESOLVER=OFF -DENABLE_ARES=OFF \
+  -DCURL_USE_PKGCONFIG=OFF -DCURL_USE_CMAKECONFIG=OFF \
+  -DMBEDTLS_INCLUDE_DIR="$TEST_PREFIX/include" \
+  -DMBEDTLS_LIBRARY="$TEST_PREFIX/lib/libmbedtls.a" \
+  -DMBEDX509_LIBRARY="$TEST_PREFIX/lib/libmbedx509.a" \
+  -DMBEDCRYPTO_LIBRARY="$TEST_PREFIX/lib/libmbedcrypto.a"
+cmake --build "$TEST_ROOT/curl-build" --parallel 2 --target install
+export CURL_CONFIG="$TEST_PREFIX/bin/curl-config"
+export LIBRARY_PATH="$TEST_PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
+"$TEST_PREFIX/bin/curl" --version
+python3 scripts/test-http-tls.py
+
+# Public, unauthenticated HEAD requests only. No pairing/OAuth codes are sent.
+# HTTP 4xx is fine; here we are checking the TLS certificate, not logging in.
+for TLS_HOST in api.cloud.vkplay.ru o2-ext-ac.vkplay.ru; do
+  "$TEST_PREFIX/bin/curl" --silent --show-error --head --ipv4 --max-time 20 \
+    --cacert "$PWD/resources/cacert.pem" --output /dev/null \
+    --write-out "$TLS_HOST TLS verified; HTTP %{http_code}\n" "https://$TLS_HOST/"
+done
