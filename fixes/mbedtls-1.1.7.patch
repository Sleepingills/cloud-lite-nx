diff --git a/cmake/switch/SwitchCurl.cmake b/cmake/switch/SwitchCurl.cmake
new file mode 100644
index 0000000..0cbe2e7
--- /dev/null
+++ b/cmake/switch/SwitchCurl.cmake
@@ -0,0 +1,67 @@
+# Build HTTPS against the same mbedTLS as WebSockets/WebRTC. The old portlib
+# curl uses Horizon SSL and only reports a generic code 60 for OAuth failures.
+# Keep all certificate, hostname and date checks enabled in core/http.cpp.
+include(FetchContent)
+
+set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
+set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
+set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
+set(BUILD_MISC_DOCS OFF CACHE BOOL "" FORCE)
+set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
+set(CURL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
+set(CURL_ENABLE_EXPORT_TARGET OFF CACHE BOOL "" FORCE)
+set(CURL_USE_MBEDTLS ON CACHE BOOL "" FORCE)
+set(CURL_USE_OPENSSL OFF CACHE BOOL "" FORCE)
+set(CURL_USE_PKGCONFIG OFF CACHE BOOL "" FORCE)
+set(CURL_USE_CMAKECONFIG OFF CACHE BOOL "" FORCE)
+set(MBEDTLS_INCLUDE_DIR ${SWITCH_MBEDTLS_PREFIX}/include CACHE PATH "" FORCE)
+set(MBEDTLS_LIBRARY ${SWITCH_MBEDTLS_PREFIX}/lib/libmbedtls.a CACHE FILEPATH "" FORCE)
+set(MBEDX509_LIBRARY ${SWITCH_MBEDTLS_PREFIX}/lib/libmbedx509.a CACHE FILEPATH "" FORCE)
+set(MBEDCRYPTO_LIBRARY ${SWITCH_MBEDTLS_PREFIX}/lib/libmbedcrypto.a CACHE FILEPATH "" FORCE)
+set(MBEDTLS_USE_STATIC_LIBS ON CACHE BOOL "" FORCE)
+# libnx has no pthread_detach; requests already run on our managed workers.
+set(ENABLE_THREADED_RESOLVER OFF CACHE BOOL "" FORCE)
+set(ENABLE_ARES OFF CACHE BOOL "" FORCE)
+set(ENABLE_IPV6 OFF CACHE BOOL "" FORCE)
+set(ENABLE_UNIX_SOCKETS OFF CACHE BOOL "" FORCE)
+set(CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
+set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
+set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
+set(USE_NGHTTP2 OFF CACHE BOOL "" FORCE)
+set(CURL_BROTLI OFF CACHE STRING "" FORCE)
+set(CURL_ZSTD OFF CACHE STRING "" FORCE)
+set(CURL_ZLIB ON CACHE STRING "" FORCE)
+set(ZLIB_INCLUDE_DIR ${DEVKITPRO}/portlibs/switch/include CACHE PATH "" FORCE)
+set(ZLIB_LIBRARY ${DEVKITPRO}/portlibs/switch/lib/libz.a CACHE FILEPATH "" FORCE)
+set(CURL_CA_BUNDLE "none" CACHE STRING "" FORCE)
+set(CURL_CA_PATH "none" CACHE STRING "" FORCE)
+set(CURL_CA_FALLBACK OFF CACHE BOOL "" FORCE)
+foreach (PROTOCOL DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP)
+    set(CURL_DISABLE_${PROTOCOL} ON CACHE BOOL "" FORCE)
+endforeach ()
+set(CURL_DISABLE_SOCKETPAIR ON CACHE BOOL "" FORCE)
+# newlib declares basename(), but the Switch link does not provide it.
+# Use curl's built-in implementation rather than the compile-only probe.
+set(HAVE_BASENAME OFF CACHE BOOL "" FORCE)
+
+# curl's FindMbedTLS otherwise creates an imported target whose headers are
+# emitted as -isystem. GCC then drops our matching -I, allowing the portlib's
+# older headers to win. Reuse the existing non-system 3.6 targets instead.
+add_library(CURL::mbedtls INTERFACE IMPORTED GLOBAL)
+set_target_properties(CURL::mbedtls PROPERTIES
+    IMPORTED_NO_SYSTEM TRUE
+    INTERFACE_INCLUDE_DIRECTORIES "${SWITCH_MBEDTLS_PREFIX}/include"
+    INTERFACE_LINK_LIBRARIES "MbedTLS::MbedTLS;MbedTLS::MbedX509;MbedTLS::MbedCrypto")
+
+FetchContent_Declare(curl_http
+    URL https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz
+    URL_HASH SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5
+    DOWNLOAD_EXTRACT_TIMESTAMP ON)
+FetchContent_MakeAvailable(curl_http)
+# Never pick the portlib's 7.69 headers ahead of the new library headers.
+set(CMAKE_C_FLAGS "-I${curl_http_SOURCE_DIR}/include ${CMAKE_C_FLAGS}")
+set(CMAKE_CXX_FLAGS "-I${curl_http_SOURCE_DIR}/include ${CMAKE_CXX_FLAGS}")
+list(PREPEND APP_PLATFORM_LIB CURL::libcurl z)
+message(STATUS "Cloud Lite HTTPS: curl 8.23.0 + mbedTLS, certificate verification enabled")
