+++ b/tests/http_tls_probe.cpp
@@ -0,0 +1,17 @@
+#include "core/http.hpp"
+#include "core/utils/thread.hpp"
+#include <iostream>
+#include <thread>
+
+// The asynchronous UI path is not exercised by this test.
+void vkpcnx::utils::runDetached(std::function<void()> fn) {
+  std::thread(std::move(fn)).detach();
+}
+int main(int argc, char **argv) {
+  if (argc != 2) return 2;
+  Http::init();
+  auto response = Http::get(argv[1]);
+  std::cout << response.transportCode << ' ' << response.status << '\n';
+  if (response.transportCode == 0 && response.body != "tls-test-ok") return 3;
+  Http::shutdown();
+}
