diff --git a/scripts/test-http-tls.py b/scripts/test-http-tls.py
new file mode 100644
index 0000000..7db4b2c
--- /dev/null
+++ b/scripts/test-http-tls.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Exercise the real HTTP client against a local HTTPS server (no credentials).
+
+Requires a host C++ compiler, libcurl development files, Python and openssl.
+Uses Switch's missing-bundle policy, but host libcurl rather than libnx SSL.
+"""
+import http.server
+import os
+from pathlib import Path
+import shlex
+import shutil
+import ssl
+import subprocess
+import tempfile
+import threading
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def run(args, **kwargs):
+    return subprocess.run(args, check=True, capture_output=True, text=True, **kwargs)
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        payload = b"tls-test-ok"
+        self.send_response(200)
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def log_message(self, *args):
+        pass
+
+
+with tempfile.TemporaryDirectory(prefix="cloud-lite-tls-") as tmp:
+    work = Path(tmp)
+    binary = work / "probe"
+    # http.cpp and tls.cpp have no Switch SDK dependency. Only their
+    # missing-resource policy is selected; TLS itself uses host libcurl.
+    flags = shlex.split(run(["curl-config", "--cflags", "--libs"]).stdout)
+    run([os.environ.get("CXX", "g++"), "-std=c++17", "-Wall", "-Wextra", "-Werror",
+         "-D__SWITCH__", '-DBRLS_RESOURCES="./resources/"',
+         "-I" + str(ROOT / "tests/http_host"),
+         "-I" + str(ROOT / "vkpcnx/include"),
+         "-I" + str(ROOT / "library/borealis/library/include"),
+         "-I" + str(ROOT / "library/borealis/library/include/borealis/extern"),
+         str(ROOT / "tests/http_tls_probe.cpp"),
+         str(ROOT / "vkpcnx/src/core/http.cpp"),
+         str(ROOT / "vkpcnx/src/core/utils/tls.cpp"),
+         "-pthread", "-o", str(binary)] + flags)
+
+    for name in ("ca", "other-ca"):
+        run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
+             "-days", "1", "-subj", "/CN=" + name,
+             "-keyout", str(work / (name + ".key")),
+             "-out", str(work / (name + ".pem"))])
+    run(["openssl", "req", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost",
+         "-keyout", str(work / "server.key"), "-out", str(work / "server.csr")])
+    (work / "extensions").write_text(
+        "subjectAltName=DNS:localhost\nextendedKeyUsage=serverAuth\n")
+    run(["openssl", "x509", "-req", "-in", str(work / "server.csr"),
+         "-CA", str(work / "ca.pem"), "-CAkey", str(work / "ca.key"),
+         "-CAcreateserial", "-days", "1", "-extfile", str(work / "extensions"),
+         "-out", str(work / "server.pem")])
+
+    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    context.load_cert_chain(work / "server.pem", work / "server.key")
+    server.socket = context.wrap_socket(server.socket, server_side=True)
+    worker = threading.Thread(target=server.serve_forever, daemon=True)
+    worker.start()
+    env = dict(os.environ, NO_PROXY="*", no_proxy="*")
+    (work / "resources").mkdir()
+    bundle = work / "resources/cacert.pem"
+    cases = [
+        ("trusted CA", "ca.pem", "localhost", "0 200"),
+        ("untrusted CA", "other-ca.pem", "localhost", "60 0"),
+        ("hostname mismatch", "ca.pem", "127.0.0.1", "60 0"),
+        ("missing bundle", None, "localhost", "77 0"),
+    ]
+    try:
+        for name, ca, host, expected in cases:
+            if ca:
+                shutil.copyfile(work / ca, bundle)
+            else:
+                bundle.unlink()
+            url = f"https://{host}:{server.server_port}/"
+            actual = run([str(binary), url], cwd=work, env=env, timeout=15).stdout.strip()
+            assert actual == expected, f"{name}: expected {expected}, got {actual}"
+            print(f"PASS: {name}")
+    finally:
+        server.shutdown()
+        server.server_close()
+        worker.join()
