@@ -0,0 +1,11 @@
+#pragma once
+// UI-only stand-in for host HTTPS tests. Http and libcurl are the real code.
+#include <functional>
+namespace brls {
+struct Logger {
+  template <typename... Args> static void info(const char *, Args &&...) {}
+  template <typename... Args> static void error(const char *, Args &&...) {}
+  template <typename... Args> static void debug(const char *, Args &&...) {}
+};
+inline void sync(std::function<void()> fn) { fn(); }
+}
